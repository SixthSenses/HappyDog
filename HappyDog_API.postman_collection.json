  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// 전역 Pre-request 스크립트",
          "console.log('🚀 API 호출:', pm.request.method, pm.request.url);",
          "",
          "// 토큰 만료 검사 (Optional)",
          "const accessToken = pm.collectionVariables.get('accessToken');",
          "if (accessToken && pm.request.auth && pm.request.auth.type === 'bearer') {",
          "    try {",
          "        // JWT 토큰 파싱 (간단한 만료 체크)",
          "        const payload = JSON.parse(atob(accessToken.split('.')[1]));",
          "        const now = Math.floor(Date.now() / 1000);",
          "        ",
          "        if (payload.exp < now) {",
          "            console.log('⚠️ Access token이 만료되었습니다. 토큰 갱신을 고려하세요.');",
          "        }",
          "    } catch (e) {",
          "        console.log('⚠️ 토큰 파싱 실패 - 유효한 JWT 토큰인지 확인하세요.');",
          "    }",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// 전역 Test 스크립트",
          "console.log('📊 Response:', pm.response.code, pm.response.status);",
          "",
          "// 공통 에러 처리",
          "if (pm.response.code >= 400) {",
          "    console.log('❌ Error Response:', pm.response.text());",
          "    ",
          "    // 토큰 만료 시 알림",
          "    if (pm.response.code === 401) {",
          "        console.log('🔐 인증 실패 - 로그인이 필요하거나 토큰이 만료되었을 수 있습니다.');",
          "    }",
          "}",
          "",
          "// Rate Limit 헤더 체크",
          "const rateLimitRemaining = pm.response.headers.get('X-RateLimit-Remaining');",
          "if (rateLimitRemaining !== null) {",
          "    console.log('⏰ Rate Limit Remaining:', rateLimitRemaining);",
          "    ",
          "    if (parseInt(rateLimitRemaining) < 10) {",
          "        console.log('⚠️ Rate limit이 거의 소진되었습니다.');",
          "    }",
          "}"
        ]
      }
    }
  ]
