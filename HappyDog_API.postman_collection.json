{
  "info": {
    "name": "HappyDog API Collection",
    "description": "반려동물 건강 관리 및 소셜 플랫폼 API 컬렉션\n\n**사용법:**\n1. 환경 변수 설정: {{baseUrl}}, {{accessToken}}, {{refreshToken}}\n2. Auth 폴더에서 소셜 로그인 실행 → 토큰 자동 저장\n3. 다른 API 호출 시 자동으로 Bearer 토큰 사용\n\n**주요 기능:**\n- Firebase 기반 백엔드\n- 펫케어 기록 관리\n- 멍스타그램 소셜 기능\n- 만화 변환 서비스",
    "version": "1.0.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string",
      "description": "API 베이스 URL (개발: localhost:5000, 프로덕션: api.happydog.com)"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string",
      "description": "JWT 액세스 토큰 (자동 저장됨)"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string",
      "description": "JWT 리프레시 토큰 (자동 저장됨)"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string",
      "description": "현재 로그인한 사용자 ID"
    },
    {
      "key": "petId",
      "value": "",
      "type": "string",
      "description": "현재 사용자의 반려동물 ID"
    },
    {
      "key": "testPostId",
      "value": "",
      "type": "string",
      "description": "테스트용 게시글 ID"
    },
    {
      "key": "testCommentId",
      "value": "",
      "type": "string",
      "description": "테스트용 댓글 ID"
    },
    {
      "key": "testJobId",
      "value": "",
      "type": "string",
      "description": "테스트용 만화 작업 ID"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "🔐 Authentication",
      "description": "인증 관련 API - Google OAuth 로그인, 토큰 관리",
      "item": [
        {
          "name": "Google OAuth 인증 URL 생성",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/google/authorize?redirect=false",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "google", "authorize"],
              "query": [
                {
                  "key": "redirect",
                  "value": "false",
                  "description": "false: JSON 응답, true: 바로 리다이렉트"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "소셜 로그인 (Google)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// 로그인 성공 시 토큰 자동 저장",
                  "if (pm.response.code === 200) {",
                  "    const responseData = pm.response.json();",
                  "    ",
                  "    // 토큰 저장",
                  "    if (responseData.access_token) {",
                  "        pm.collectionVariables.set('accessToken', responseData.access_token);",
                  "        console.log('✅ Access Token saved:', responseData.access_token.substring(0, 20) + '...');",
                  "    }",
                  "    ",
                  "    if (responseData.refresh_token) {",
                  "        pm.collectionVariables.set('refreshToken', responseData.refresh_token);",
                  "        console.log('✅ Refresh Token saved:', responseData.refresh_token.substring(0, 20) + '...');",
                  "    }",
                  "    ",
                  "    // 사용자 정보 저장",
                  "    if (responseData.user_id) {",
                  "        pm.collectionVariables.set('userId', responseData.user_id);",
                  "        console.log('✅ User ID saved:', responseData.user_id);",
                  "    }",
                  "    ",
                  "    // 신규 사용자 여부 로그",
                  "    if (responseData.is_new_user !== undefined) {",
                  "        console.log('👤 Is new user:', responseData.is_new_user);",
                  "    }",
                  "    ",
                  "    // 사용자 정보 로그",
                  "    if (responseData.user_info) {",
                  "        console.log('👤 User info:', JSON.stringify(responseData.user_info, null, 2));",
                  "    }",
                  "    ",
                  "    // 성공 메시지",
                  "    pm.test('로그인 성공 및 토큰 저장 완료', function () {",
                  "        pm.expect(responseData.access_token).to.be.a('string');",
                  "        pm.expect(responseData.refresh_token).to.be.a('string');",
                  "    });",
                  "} else {",
                  "    console.log('❌ 로그인 실패:', pm.response.text());",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"provider\": \"google\",\n  \"auth_code\": \"4/0AdQt8qh...\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/social",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "social"]
            },
            "description": "Google OAuth 코드를 사용하여 로그인/회원가입\n\n**주의:** Google OAuth 인증 완료 후 받은 auth_code를 입력하세요."
          },
          "response": []
        },
        {
          "name": "토큰 갱신",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// 토큰 갱신 성공 시 새 액세스 토큰 저장",
                  "if (pm.response.code === 200) {",
                  "    const responseData = pm.response.json();",
                  "    ",
                  "    if (responseData.access_token) {",
                  "        pm.collectionVariables.set('accessToken', responseData.access_token);",
                  "        console.log('✅ New Access Token saved:', responseData.access_token.substring(0, 20) + '...');",
                  "    }",
                  "    ",
                  "    pm.test('토큰 갱신 성공', function () {",
                  "        pm.expect(responseData.access_token).to.be.a('string');",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{refreshToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/token/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "token", "refresh"]
            }
          },
          "response": []
        },
        {
          "name": "로그아웃",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// 로그아웃 성공 시 저장된 토큰 제거",
                  "if (pm.response.code === 200) {",
                  "    pm.collectionVariables.set('accessToken', '');",
                  "    pm.collectionVariables.set('refreshToken', '');",
                  "    pm.collectionVariables.set('userId', '');",
                  "    console.log('✅ 로그아웃 완료 - 토큰이 제거되었습니다.');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"access_token\": \"{{accessToken}}\",\n  \"refresh_token\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "logout"]
            }
          },
          "response": []
        }
      ]
    },
